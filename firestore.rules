rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3 & Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFundCode(code) {
      return code is string && code.size() == 6 && code.matches('^[0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 1: Master Gate parent check
    function userProfileExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Pillar 2: Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data, userId, fundCode) {
      return data.keys().hasAll(['ownerId', 'fundCode', 'name', 'category', 'beta', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'fundCode', 'name', 'category', 'beta', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.fundCode is string
        && data.fundCode == fundCode
        && isValidFundCode(data.fundCode)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.category is string
        && data.category in ['index_ndx', 'global_active', 'qdii_other']
        && data.beta is number
        && data.beta >= 0.1
        && data.beta <= 2.0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHolding(data, userId, fundCode) {
      return data.keys().hasAll(['ownerId', 'fundCode', 'name', 'shares', 'costNav', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'fundCode', 'name', 'shares', 'costNav', 'note', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.fundCode is string
        && data.fundCode == fundCode
        && isValidFundCode(data.fundCode)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.shares is number
        && data.shares > 0
        && data.shares <= 1000000000
        && data.costNav is number
        && data.costNav > 0
        && data.costNav <= 100000
        && (!('note' in data) || (data.note is string && data.note.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId);

      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;

      // Subcollection: /users/{userId}/watchlist/{fundCode}
      match /watchlist/{fundCode} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId);

        // Pillar 8: Secure List Query without get()/exists()
        allow list: if isVerifiedUser()
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId)
          && isValidWatchlistItem(incoming(), userId, fundCode)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userProfileExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId)
          && isValidWatchlistItem(incoming(), userId, fundCode)
          && incoming().ownerId == existing().ownerId
          && incoming().fundCode == existing().fundCode
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'beta', 'updatedAt'])
          && userProfileExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId);
      }

      // Subcollection: /users/{userId}/holdings/{fundCode}
      match /holdings/{fundCode} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId);

        // Pillar 8: Secure List Query without get()/exists()
        allow list: if isVerifiedUser()
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId)
          && isValidHolding(incoming(), userId, fundCode)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userProfileExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId)
          && isValidHolding(incoming(), userId, fundCode)
          && incoming().ownerId == existing().ownerId
          && incoming().fundCode == existing().fundCode
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['shares', 'costNav', 'note', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['shares', 'costNav', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'shares', 'costNav', 'note', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'shares', 'costNav', 'updatedAt'])
          )
          && userProfileExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidFundCode(fundCode)
          && isOwner(userId);
      }
    }
  }
}
